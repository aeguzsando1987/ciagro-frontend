# Variables de entorno del frontend de CIAgro.
# Copiar a .env.local y completar con valores reales (no committear .env.local).

# URL base de la API del backend Django (incluye el prefijo /api/v1/).
# En desarrollo apunta al servicio local. En producción, al dominio de la API.
VITE_API_BASE_URL=http://localhost:8500/api/v1

# El visor NO necesita clave de tiles: usa capas gratuitas y sin key de ESRI
# (ver src/features/geodata-visor/lib/mapModes.ts). VITE_MAPTILER_KEY existio
# mientras se evaluo MapTiler free tier (GAP-INFRA-001) y se elimino en la
# FASE CL-F: ningun archivo de src/ la leia, pero el runbook de despliegue
# mandaba PARAR si estaba vacia (GAP-CL-F-003).
